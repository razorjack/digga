# Read from the folder digga runs from; variables already set in the environment win.

# The library: database, backups, config and saved token.
# Default: ~/Library/Application Support/Digga, %APPDATA%\Digga or ~/.config/Digga.
# DIGGA_DATA_DIR=./data

# Dumps, 10 GB each. Default: the folder chosen in the desktop app, else the OS cache folder, or
# dumps/ in DIGGA_DATA_DIR when that is set.
# DIGGA_DUMPS_DIR=

# Default: digga.config.json in the library folder.
# DIGGA_CONFIG_FILE=

# Overrides the token saved in Settings, which then cannot change it.
# DISCOGS_TOKEN=

# Development: other addresses for data.discogs.com, the Discogs API and YouTube's oEmbed, such
# as the fakes `node tools/dev/fake-services.ts` serves, which print these three lines.
# DIGGA_DUMPS_URL=http://127.0.0.1:4567/dumps/
# DIGGA_DISCOGS_API_URL=http://127.0.0.1:4567/discogs
# DIGGA_YOUTUBE_OEMBED_URL=http://127.0.0.1:4567/youtube/oembed
