# Read from the folder digga runs from; variables already set in the environment win.

# The library: database, backups, config and saved token.
# Default: ~/Library/Application Support/Digga, %APPDATA%\Digga or ~/.config/Digga.
# DIGGA_DATA_DIR=./data

# Dumps, 10 GB each. Default: the OS cache folder, or dumps/ in DIGGA_DATA_DIR when that is set.
# DIGGA_DUMPS_DIR=

# Default: digga.config.json in the library folder.
# DIGGA_CONFIG_FILE=

# Overrides the token saved in Settings, which then cannot change it.
# DISCOGS_TOKEN=

# Development: other addresses for data.discogs.com, the Discogs API and YouTube's oEmbed, such
# as tools/dev/fake-data-dumps.ts or the end-to-end tests' fake services.
# DIGGA_DUMPS_URL=http://127.0.0.1:4567/
# DIGGA_DISCOGS_API_URL=
# DIGGA_YOUTUBE_OEMBED_URL=
